#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// 64x64x32 Scaled FP16->FP32 WMMA Dense BF16 GEMM (Wave64-native):
// WG: 64 x 4 = 256 threads = 4 Wave64 subgroups, each owning 16 rows x 64 tokens (four 16x16 FP32 accumulators).
// LDS: 12 KiB -> 5 WGs/CU! Grid: ((rows+63)/64, (B+63)/64, 1)
layout(local_size_x = 64, local_size_y = 4) in;

layout(buffer_reference, std430, buffer_reference_align = 16) readonly  buffer UVec4In { uvec4 v[]; };
layout(buffer_reference, std430, buffer_reference_align = 16) readonly  buffer Vec4In  { vec4  v[]; };
layout(buffer_reference, std430, buffer_reference_align = 4)  writeonly buffer F32Out  { float v[]; };

layout(push_constant) uniform PC {
    uint64_t w_addr; // BF16 [rows, cols] (cols multiple of 32)
    uint64_t x_addr; // F32  [B, cols]
    uint64_t y_addr; // F32  [B, rows]
    uint rows;
    uint cols;
    uint B;
} pc;

shared float16_t s_w[64 * 32];    // 4 KiB: [r 0..63][k 0..31]
shared float16_t s_x[64 * 32];    // 4 KiB: [t 0..63][k 0..31]
shared float     s_c[4][16 * 16]; // 4 KiB: epilogue scratch per subgroup

vec2 ub2(uint p) { return vec2(uintBitsToFloat((p & 0xFFFFu) << 16), uintBitsToFloat(p & 0xFFFF0000u)); }

void main() {
    uint lane = gl_LocalInvocationID.x; // 0..63 (one Wave64 subgroup)
    uint sub  = gl_LocalInvocationID.y; // 0..3
    uint lid  = sub * 64u + lane;       // 0..255

    uint r_base = gl_WorkGroupID.x * 64u;
    uint t_base = gl_WorkGroupID.y * 64u;

    uint wr_local = lid >> 2; // 0..63
    uint wk_v8    = lid & 3u; // 0..3 -> 8 BF16s
    uint gr       = r_base + wr_local;

    uint xr_local = lid >> 3; // 0..31 (2 passes for 0..63)
    uint xk_v4    = lid & 7u; // 0..7 -> 4 F32s
    uint cols_v8  = pc.cols >> 3;
    uint cols_v4  = pc.cols >> 2;

    UVec4In wb = UVec4In(pc.w_addr);
    Vec4In  xb = Vec4In(pc.x_addr);

    const float X_SC   = 0.0625; // 1/16 to guarantee zero FP16 overflow
    const float X_UNSC = 16.0;

    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> c0 = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> c1 = c0, c2 = c0, c3 = c0;

    uint nt_wg = (t_base < pc.B) ? min(64u, pc.B - t_base) : 0u;

    for (uint k0 = 0u; k0 < pc.cols; k0 += 32u) {
        // Load W[64, 32] BF16 -> s_w FP16 (coalesced 64B/row)
        uint sw_off = wr_local * 32u + wk_v8 * 8u;
        if (gr < pc.rows) {
            uvec4 w = wb.v[uint(uint64_t(gr) * uint64_t(cols_v8) + uint64_t((k0 >> 3) + wk_v8))];
            vec2 a = ub2(w.x), b = ub2(w.y), c = ub2(w.z), d = ub2(w.w);
            s_w[sw_off + 0u] = float16_t(a.x); s_w[sw_off + 1u] = float16_t(a.y);
            s_w[sw_off + 2u] = float16_t(b.x); s_w[sw_off + 3u] = float16_t(b.y);
            s_w[sw_off + 4u] = float16_t(c.x); s_w[sw_off + 5u] = float16_t(c.y);
            s_w[sw_off + 6u] = float16_t(d.x); s_w[sw_off + 7u] = float16_t(d.y);
        } else {
            for (uint u = 0u; u < 8u; ++u) s_w[sw_off + u] = float16_t(0.0);
        }
        // Load X[64, 32] F32 -> s_x FP16 in 2 coalesced 128B bursts
        uint xk = xk_v4 * 4u;
        uint sx0 = xr_local * 32u + xk;
        uint gt0 = t_base + xr_local;
        if (gt0 < pc.B) {
            vec4 xv = xb.v[gt0 * cols_v4 + (k0 >> 2) + xk_v4] * X_SC;
            s_x[sx0 + 0u] = float16_t(xv.x); s_x[sx0 + 1u] = float16_t(xv.y);
            s_x[sx0 + 2u] = float16_t(xv.z); s_x[sx0 + 3u] = float16_t(xv.w);
        } else {
            s_x[sx0 + 0u] = float16_t(0.0); s_x[sx0 + 1u] = float16_t(0.0);
            s_x[sx0 + 2u] = float16_t(0.0); s_x[sx0 + 3u] = float16_t(0.0);
        }
        uint sx1 = (xr_local + 32u) * 32u + xk;
        uint gt1 = gt0 + 32u;
        if (gt1 < pc.B) {
            vec4 xv = xb.v[gt1 * cols_v4 + (k0 >> 2) + xk_v4] * X_SC;
            s_x[sx1 + 0u] = float16_t(xv.x); s_x[sx1 + 1u] = float16_t(xv.y);
            s_x[sx1 + 2u] = float16_t(xv.z); s_x[sx1 + 3u] = float16_t(xv.w);
        } else {
            s_x[sx1 + 0u] = float16_t(0.0); s_x[sx1 + 1u] = float16_t(0.0);
            s_x[sx1 + 2u] = float16_t(0.0); s_x[sx1 + 3u] = float16_t(0.0);
        }
        barrier();

        // WMMA: 2 K-steps of 16 x up to 4 N-tiles of 16
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> a;
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> b;
        uint a_base = sub * 16u * 32u;

        coopMatLoad(a, s_w, a_base + 0u, 32u, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(b, s_x,  0u * 32u + 0u, 32u, gl_CooperativeMatrixLayoutColumnMajor); c0 = coopMatMulAdd(a, b, c0);
        if (nt_wg > 16u) { coopMatLoad(b, s_x, 16u * 32u + 0u, 32u, gl_CooperativeMatrixLayoutColumnMajor); c1 = coopMatMulAdd(a, b, c1); }
        if (nt_wg > 32u) { coopMatLoad(b, s_x, 32u * 32u + 0u, 32u, gl_CooperativeMatrixLayoutColumnMajor); c2 = coopMatMulAdd(a, b, c2); }
        if (nt_wg > 48u) { coopMatLoad(b, s_x, 48u * 32u + 0u, 32u, gl_CooperativeMatrixLayoutColumnMajor); c3 = coopMatMulAdd(a, b, c3); }

        coopMatLoad(a, s_w, a_base + 16u, 32u, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(b, s_x,  0u * 32u + 16u, 32u, gl_CooperativeMatrixLayoutColumnMajor); c0 = coopMatMulAdd(a, b, c0);
        if (nt_wg > 16u) { coopMatLoad(b, s_x, 16u * 32u + 16u, 32u, gl_CooperativeMatrixLayoutColumnMajor); c1 = coopMatMulAdd(a, b, c1); }
        if (nt_wg > 32u) { coopMatLoad(b, s_x, 32u * 32u + 16u, 32u, gl_CooperativeMatrixLayoutColumnMajor); c2 = coopMatMulAdd(a, b, c2); }
        if (nt_wg > 48u) { coopMatLoad(b, s_x, 48u * 32u + 16u, 32u, gl_CooperativeMatrixLayoutColumnMajor); c3 = coopMatMulAdd(a, b, c3); }
        barrier();
    }

    // Epilogue: store 16x16 tiles to global F32 output
    F32Out yb = F32Out(pc.y_addr);
    uint rl = lane >> 2;         // 0..15
    uint t0 = (lane & 3u) * 4u;  // 0,4,8,12
    uint gr_o = r_base + sub * 16u + rl;

    #define STORE_TILE(CM, T_OFF) { \
        coopMatStore(CM, s_c[sub], 0u, 16u, gl_CooperativeMatrixLayoutRowMajor); \
        subgroupBarrier(); \
        if (gr_o < pc.rows) { \
            for (uint u = 0u; u < 4u; ++u) { \
                uint gt = t_base + T_OFF + t0 + u; \
                if (gt < pc.B) yb.v[gt * pc.rows + gr_o] = s_c[sub][rl * 16u + t0 + u] * X_UNSC; \
            } \
        } \
        subgroupBarrier(); \
    }
    STORE_TILE(c0,  0u)
    if (nt_wg > 16u) STORE_TILE(c1, 16u)
    if (nt_wg > 32u) STORE_TILE(c2, 32u)
    if (nt_wg > 48u) STORE_TILE(c3, 48u)
}
