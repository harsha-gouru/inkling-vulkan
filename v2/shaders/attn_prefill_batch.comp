#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_KHR_shader_subgroup_arithmetic : require
// Q-tiled causal FlashAttention: each 64-thread WG handles 1 head x up to 4 query tokens,
// reading K[j] and V[j] ONCE per j and sharing across all 4 queries in VGPRs!
// Grid: (N_HEADS=24, (B+3)/4, 1)
layout(local_size_x = 64) in;

layout(buffer_reference, std430, buffer_reference_align = 4) readonly  buffer F32In  { float v[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) readonly  buffer U32In  { uint  v[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer F32Out { float v[]; };

layout(push_constant) uniform PC {
    uint64_t q_addr;        // [B, 3072]
    uint64_t r_addr;        // [B, 384]
    uint64_t sink_addr;     // [B, 24]
    uint64_t gate_addr;     // [B, 3072]
    uint64_t rel_proj_addr; // BF16 transposed [1024, 16]
    uint64_t k_cache_addr;  // F32 [cap, 1024]
    uint64_t v_cache_addr;  // F32 [cap, 1024]
    uint64_t out_addr;      // [B, 3072]
    uint pos_start;
    uint is_glob;
    uint ring_mask;         // 0 for Global, 1023 for SWA
    uint B;
    uint q_tile;
} pc;

float read_bf16(U32In buf, uint idx) {
    uint p = buf.v[idx >> 1];
    uint bits = ((idx & 1u) == 0u) ? ((p & 0xFFFFu) << 16) : (p & 0xFFFF0000u);
    return uintBitsToFloat(bits);
}

void main() {
    uint h   = gl_WorkGroupID.x;
    uint t0  = gl_WorkGroupID.y * pc.q_tile;
    uint nt  = min(pc.q_tile, pc.B - t0);
    uint tid = gl_LocalInvocationID.x;
    uint kvh = h / 3u;
    uint d0 = tid, d1 = tid + 64u;

    uint pos0 = pc.pos_start + t0;
    uint pos_end = pos0 + nt - 1u;
    uint start_j = (pc.is_glob != 0u) ? 0u : ((pos0 >= 1023u) ? (pos0 - 1023u) : 0u);

    F32In qb = F32In(pc.q_addr);
    F32In rb = F32In(pc.r_addr);
    F32In sb = F32In(pc.sink_addr);
    F32In gb = F32In(pc.gate_addr);
    U32In rp = U32In(pc.rel_proj_addr);
    F32In kc = F32In(pc.k_cache_addr);
    F32In vc = F32In(pc.v_cache_addr);
    F32Out ob = F32Out(pc.out_addr);

    uint qb0 = (t0 + 0u) * 3072u + h * 128u;
    uint qb1 = (t0 + 1u) * 3072u + h * 128u;
    uint qb2 = (t0 + 2u) * 3072u + h * 128u;
    uint qb3 = (t0 + 3u) * 3072u + h * 128u;
    float q0a = qb.v[qb0+d0], q0b = qb.v[qb0+d1];
    float q1a = (nt>1u)?qb.v[qb1+d0]:0.0, q1b = (nt>1u)?qb.v[qb1+d1]:0.0;
    float q2a = (nt>2u)?qb.v[qb2+d0]:0.0, q2b = (nt>2u)?qb.v[qb2+d1]:0.0;
    float q3a = (nt>3u)?qb.v[qb3+d0]:0.0, q3b = (nt>3u)?qb.v[qb3+d1]:0.0;

    float r0 = (tid < 16u) ? rb.v[(t0+0u)*384u + h*16u + tid] : 0.0;
    float r1 = (tid < 16u && nt>1u) ? rb.v[(t0+1u)*384u + h*16u + tid] : 0.0;
    float r2 = (tid < 16u && nt>2u) ? rb.v[(t0+2u)*384u + h*16u + tid] : 0.0;
    float r3 = (tid < 16u && nt>3u) ? rb.v[(t0+3u)*384u + h*16u + tid] : 0.0;

    float m0=-1e30, l0=0.0, a0a=0.0, a0b=0.0;
    float m1=-1e30, l1=0.0, a1a=0.0, a1b=0.0;
    float m2=-1e30, l2=0.0, a2a=0.0, a2b=0.0;
    float m3=-1e30, l3=0.0, a3a=0.0, a3b=0.0;
    const float sc = inversesqrt(128.0);

    for (uint j = start_j; j <= pos_end; ++j) {
        uint phys = (pc.ring_mask != 0u) ? (j & pc.ring_mask) : j;
        uint kv_base = phys * 1024u + kvh * 128u;
        float k0 = kc.v[kv_base + d0], k1 = kc.v[kv_base + d1];
        float v0 = vc.v[kv_base + d0], v1 = vc.v[kv_base + d1];

        // Query 0 (pos0)
        if (j <= pos0 && (pc.is_glob != 0u || (pos0 - j) < 1024u)) {
            float dot = subgroupAdd(q0a * k0 + q0b * k1);
            uint dist = pos0 - j;
            float rb_v = (dist < 1024u) ? subgroupAdd((tid < 16u) ? (r0 * read_bf16(rp, dist * 16u + tid)) : 0.0) : 0.0;
            float s = dot * sc + rb_v;
            float mn = max(m0, s); float al = (l0 > 0.0) ? exp(m0 - mn) : 0.0; float p = exp(s - mn);
            l0 = l0 * al + p; a0a = a0a * al + p * v0; a0b = a0b * al + p * v1; m0 = mn;
        }
        // Query 1 (pos0+1)
        if (nt > 1u && j <= pos0 + 1u && (pc.is_glob != 0u || (pos0 + 1u - j) < 1024u)) {
            float dot = subgroupAdd(q1a * k0 + q1b * k1);
            uint dist = pos0 + 1u - j;
            float rb_v = (dist < 1024u) ? subgroupAdd((tid < 16u) ? (r1 * read_bf16(rp, dist * 16u + tid)) : 0.0) : 0.0;
            float s = dot * sc + rb_v;
            float mn = max(m1, s); float al = (l1 > 0.0) ? exp(m1 - mn) : 0.0; float p = exp(s - mn);
            l1 = l1 * al + p; a1a = a1a * al + p * v0; a1b = a1b * al + p * v1; m1 = mn;
        }
        // Query 2 (pos0+2)
        if (nt > 2u && j <= pos0 + 2u && (pc.is_glob != 0u || (pos0 + 2u - j) < 1024u)) {
            float dot = subgroupAdd(q2a * k0 + q2b * k1);
            uint dist = pos0 + 2u - j;
            float rb_v = (dist < 1024u) ? subgroupAdd((tid < 16u) ? (r2 * read_bf16(rp, dist * 16u + tid)) : 0.0) : 0.0;
            float s = dot * sc + rb_v;
            float mn = max(m2, s); float al = (l2 > 0.0) ? exp(m2 - mn) : 0.0; float p = exp(s - mn);
            l2 = l2 * al + p; a2a = a2a * al + p * v0; a2b = a2b * al + p * v1; m2 = mn;
        }
        // Query 3 (pos0+3)
        if (nt > 3u && j <= pos0 + 3u && (pc.is_glob != 0u || (pos0 + 3u - j) < 1024u)) {
            float dot = subgroupAdd(q3a * k0 + q3b * k1);
            uint dist = pos0 + 3u - j;
            float rb_v = (dist < 1024u) ? subgroupAdd((tid < 16u) ? (r3 * read_bf16(rp, dist * 16u + tid)) : 0.0) : 0.0;
            float s = dot * sc + rb_v;
            float mn = max(m3, s); float al = (l3 > 0.0) ? exp(m3 - mn) : 0.0; float p = exp(s - mn);
            l3 = l3 * al + p; a3a = a3a * al + p * v0; a3b = a3b * al + p * v1; m3 = mn;
        }
    }

    #define WRITE_Q(IDX, M, L, AA, AB, QB) { \
        float sk = sb.v[(t0 + IDX) * 24u + h]; \
        float mg = max(sk, M); float w = (L > 0.0) ? exp(M - mg) : 0.0; \
        float inv_l = 1.0 / (exp(sk - mg) + L * w); \
        ob.v[QB + d0] = ((AA * w) * inv_l) / (1.0 + exp(-gb.v[QB + d0])); \
        ob.v[QB + d1] = ((AB * w) * inv_l) / (1.0 + exp(-gb.v[QB + d1])); \
    }
    WRITE_Q(0u, m0, l0, a0a, a0b, qb0)
    if (nt > 1u) WRITE_Q(1u, m1, l1, a1a, a1b, qb1)
    if (nt > 2u) WRITE_Q(2u, m2, l2, a2a, a2b, qb2)
    if (nt > 3u) WRITE_Q(3u, m3, l3, a3a, a3b, qb3)
}
