#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
// Mode 0 (1 WG of 256): pack joint[5120] = [state(256), w1[prev](256), H[i](2304), ctx_m(2304)]
// Mode 1 (1 WG of 256): add rnn_bias, update GRU state[256], write mk[256] = tanh(chunk2)
// Mode 2 (1 WG of 256): add hidden_out.bias to dh[2304]
layout(local_size_x = 256) in;

layout(buffer_reference, std430, buffer_reference_align = 4) readonly  buffer F32In  { float v[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) readonly  buffer U32In  { uint  v[]; };
layout(buffer_reference, std430, buffer_reference_align = 4)           buffer F32RW  { float v[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer F32Out { float v[]; };

layout(push_constant) uniform PC {
    uint64_t a_addr;
    uint64_t b_addr;
    uint64_t c_addr;
    uint64_t d_addr;
    uint64_t out_addr;
    uint64_t tok_ptr_addr; // pointer to uint32 prev_tok
    uint mode;
} pc;

float read_bf16(U32In buf, uint idx) {
    uint p = buf.v[idx >> 1];
    uint bits = ((idx & 1u) == 0u) ? ((p & 0xFFFFu) << 16) : (p & 0xFFFF0000u);
    return uintBitsToFloat(bits);
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    if (pc.mode == 0u) {
        // a=state[256], b=w1_bf16[V,256], c=H_i[2304], d=ctx_m[2304], out=joint[5120]
        F32Out jt = F32Out(pc.out_addr);
        jt.v[tid] = F32In(pc.a_addr).v[tid];
        uint prev = U32In(pc.tok_ptr_addr).v[0];
        jt.v[256u + tid] = read_bf16(U32In(pc.b_addr), prev * 256u + tid);
        F32In hi = F32In(pc.c_addr);
        F32In cm = F32In(pc.d_addr);
        for (uint k = tid; k < 2304u; k += 256u) {
            jt.v[512u + k] = hi.v[k];
            jt.v[2816u + k] = cm.v[k];
        }
    } else if (pc.mode == 1u) {
        // a=proj[768], b=rnn_bias_bf16[768], c=state_rw[256], out=mk[256]
        F32In pr = F32In(pc.a_addr);
        U32In rb = U32In(pc.b_addr);
        F32RW st = F32RW(pc.c_addr);
        float p0 = pr.v[tid]        + read_bf16(rb, tid);
        float p1 = pr.v[256u + tid] + read_bf16(rb, 256u + tid);
        float p2 = pr.v[512u + tid] + read_bf16(rb, 512u + tid);
        float g = 1.0 / (1.0 + exp(-p0));
        float c = tanh(p1);
        st.v[tid] = g * st.v[tid] + (1.0 - g) * c;
        F32Out(pc.out_addr).v[tid] = tanh(p2);
    } else if (pc.mode == 2u) {
        uint t = gl_WorkGroupID.x;
        uint64_t off = uint64_t(t) * 2304ul * 4ul;
        F32In  src = F32In(pc.a_addr + off);
        U32In  hb  = U32In(pc.b_addr);
        F32Out dst = F32Out(pc.out_addr + off);
        for (uint k = tid; k < 2304u; k += 256u) {
            dst.v[k] = src.v[k] + read_bf16(hb, k);
        }
    }
}
