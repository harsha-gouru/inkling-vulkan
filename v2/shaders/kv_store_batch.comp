#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
// Stores B tokens of K and V into linear (Global) or ring (SWA, mask=1023) KV cache.
// Grid: (16, B, 1) -> 16 * 64 = 1024 = KV_DIM
layout(local_size_x = 64) in;

layout(buffer_reference, std430, buffer_reference_align = 4) readonly  buffer F32In  { float v[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer F32Out { float v[]; };

layout(push_constant) uniform PC {
    uint64_t k_in_addr;    // [B, 1024]
    uint64_t v_in_addr;    // [B, 1024]
    uint64_t k_cache_addr; // [cap, 1024]
    uint64_t v_cache_addr; // [cap, 1024]
    uint pos_start;
    uint ring_mask;        // 0 for linear, 1023 for SWA ring
} pc;

void main() {
    uint c = gl_WorkGroupID.x * 64u + gl_LocalInvocationID.x;
    uint t = gl_WorkGroupID.y;
    uint pos = pc.pos_start + t;
    uint phys = (pc.ring_mask != 0u) ? (pos & pc.ring_mask) : pos;
    F32Out(pc.k_cache_addr).v[phys * 1024u + c] = F32In(pc.k_in_addr).v[t * 1024u + c];
    F32Out(pc.v_cache_addr).v[phys * 1024u + c] = F32In(pc.v_in_addr).v[t * 1024u + c];
}
