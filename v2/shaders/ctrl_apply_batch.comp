#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
// Grid: (dim/64=36, n_ctrl=1 or 3, B)
layout(local_size_x = 64) in;

layout(buffer_reference, std430, buffer_reference_align = 16) readonly  buffer UVec4In { uvec4 v[]; };
layout(buffer_reference, std430, buffer_reference_align = 4)  readonly  buffer F32In   { float v[]; };
layout(buffer_reference, std430, buffer_reference_align = 4)  writeonly buffer F32Out  { float v[]; };

layout(push_constant) uniform PC {
    uint64_t cur_addr[3];
    uint64_t msg_addr[3];
    uint64_t gate_addr[3];
    uint64_t gain_w_addr[3];
    uint64_t forget_w_addr[3];
    uint64_t out_addr[3];
    uint dim;
    uint rank;
} pc;

shared float s_gate[64];

vec2 unpack_bf16x2(uint packed) {
    return vec2(uintBitsToFloat((packed & 0xFFFFu) << 16), uintBitsToFloat(packed & 0xFFFF0000u));
}

void main() {
    uint c = gl_WorkGroupID.y;
    uint t = gl_WorkGroupID.z;
    uint tid = gl_LocalInvocationID.x;
    uint r = gl_WorkGroupID.x * 64u + tid;
    s_gate[tid] = F32In(pc.gate_addr[c]).v[t * pc.rank + tid];
    barrier();
    if (r >= pc.dim) return;

    UVec4In gw = UVec4In(pc.gain_w_addr[c]);
    UVec4In fw = UVec4In(pc.forget_w_addr[c]);
    uint wbase = r * 8u;
    float dg = 0.0, df = 0.0;
    for (uint j = 0u; j < 8u; ++j) {
        uint g0 = j * 8u;
        vec4 x0 = vec4(s_gate[g0+0u], s_gate[g0+1u], s_gate[g0+2u], s_gate[g0+3u]);
        vec4 x1 = vec4(s_gate[g0+4u], s_gate[g0+5u], s_gate[g0+6u], s_gate[g0+7u]);
        uvec4 wg = gw.v[wbase + j];
        dg += dot(vec4(unpack_bf16x2(wg.x), unpack_bf16x2(wg.y)), x0)
            + dot(vec4(unpack_bf16x2(wg.z), unpack_bf16x2(wg.w)), x1);
        uvec4 wf = fw.v[wbase + j];
        df += dot(vec4(unpack_bf16x2(wf.x), unpack_bf16x2(wf.y)), x0)
            + dot(vec4(unpack_bf16x2(wf.z), unpack_bf16x2(wf.w)), x1);
    }
    uint idx = t * pc.dim + r;
    float cur = F32In(pc.cur_addr[c]).v[idx];
    float msg = F32In(pc.msg_addr[c]).v[idx];
    F32Out(pc.out_addr[c]).v[idx] = (cur - tanh(df) * cur) + tanh(dg) * msg;
}
